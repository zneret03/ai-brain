# Your own plans, reviews, hunt reports and bugs: the first /plan makes the folder; never published.
/sprints/

# Your workspace's product facts, read by the skills; profile.example/ shows the shape.
/profile/

# Local, untracked instructions for your own setup.
/CLAUDE.local.md

# Your projects: copy ai-brain/projects/_template/ to make one.
/ai-brain/projects/*
!/ai-brain/projects/_template/

# Evals run against your own workspace.
/ai-brain/tests/eval/

# Python bytecode anywhere in the tree.
__pycache__/

# Node packages, and the GitHub session pr-images saves (a credential).
node_modules/
/evidence/.auth/
