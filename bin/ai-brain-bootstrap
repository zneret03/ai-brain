#!/usr/bin/env bash
# Creates ai-brain/.venv, .env and var/. Every Python package stays inside the venv.
# Safe to re-run: it installs from requirements.lock once that exists.
#
#   ai-brain/bin/ai-brain-bootstrap    no options; ai-brain-up runs it when the venv or .env is missing,
#                                      or requirements.lock changed since the last install
set -euo pipefail
if [ "${1:-}" = -h ] || [ "${1:-}" = --help ]; then awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; exit 0; fi
BRAIN="$(cd "$(dirname "$0")/../ai-brain" && pwd)"
cd "$BRAIN"
mkdir -p var/cache/pip var/neo4j/data var/neo4j/logs var/sessions var/log
export PYTHONNOUSERSITE=1 PIP_CACHE_DIR="$BRAIN/var/cache/pip" XDG_CACHE_HOME="$BRAIN/var/cache"

[ -x .venv/bin/python ] || python3 -m venv --without-pip .venv
if [ ! -x .venv/bin/pip ]; then
  curl -fsSL https://bootstrap.pypa.io/get-pip.py -o var/get-pip.py
  .venv/bin/python var/get-pip.py --no-cache-dir
fi
if [ -f requirements.lock ]; then
  .venv/bin/pip install --cache-dir var/cache/pip -r requirements.lock
  .venv/bin/pip install --cache-dir var/cache/pip --no-deps -e .
else
  .venv/bin/pip install --cache-dir var/cache/pip -e '.[dev]'
  .venv/bin/pip freeze --exclude-editable > requirements.lock
fi
cp requirements.lock .venv/requirements.lock  # ai-brain-up re-runs this script when the two differ

if [ ! -f .env ]; then
  umask 077
  printf 'HOST_UID=%s\nHOST_GID=%s\nNEO4J_PASSWORD=%s\n' "$(id -u)" "$(id -g)" \
    "$(.venv/bin/python -c 'import secrets; print(secrets.token_urlsafe(24))')" > .env
fi
echo "ai-brain: bootstrapped in $BRAIN. Next: docker compose -f $BRAIN/compose.yaml up -d"
